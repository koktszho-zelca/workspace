#!/bin/bash
# Usage: sb branch_name  -> prints matching branch name, no trailing newline
[ -z "$1" ] && { echo "Usage: sb branch_name" >&2; exit 1; }

BRANCHES=$(git branch --format='%(refname:short)' 2>/dev/null)

if printf '%s\n' "$BRANCHES" | grep -qxF -- "$1"; then
  MATCH="$1"
else
  MATCH=$(printf '%s\n' "$BRANCHES" | grep -iF -- "$1" | head -n 1)
fi

[ -z "$MATCH" ] && { echo "No branch matching '$1'" >&2; exit 1; }
printf '%s' "$MATCH"
