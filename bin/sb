#!/bin/bash
# Usage: sb branch_name  -> prints matching branch name, no trailing newline
[ -z "$1" ] && { echo "Usage: sb branch_name" >&2; exit 1; }

find_match() {
  if printf '%s\n' "$1" | grep -qxF -- "$2"; then
    printf '%s' "$2"
  else
    printf '%s\n' "$1" | grep -iF -- "$2" | head -n 1
  fi
}

BRANCHES=$(git branch --format='%(refname:short)' 2>/dev/null)
MATCH=$(find_match "$BRANCHES" "$1")

if [ -z "$MATCH" ]; then
  BRANCHES=$(git for-each-ref --format='%(refname) %(symref)' refs/remotes/origin/ 2>/dev/null |
    sed -n 's|^refs/remotes/origin/\(.*\) $|\1|p')
  MATCH=$(find_match "$BRANCHES" "$1")
fi

[ -z "$MATCH" ] && { echo "No branch matching '$1'" >&2; exit 1; }
printf '%s' "$MATCH"
