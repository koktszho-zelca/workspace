#!/bin/bash
# Copy current branch name to clipboard (also prints it)
BRANCH=$(git rev-parse --abbrev-ref HEAD) || exit 1

if command -v pbcopy >/dev/null; then
  printf '%s' "$BRANCH" | pbcopy
elif command -v wl-copy >/dev/null; then
  printf '%s' "$BRANCH" | wl-copy
elif command -v xclip >/dev/null; then
  printf '%s' "$BRANCH" | xclip -selection clipboard
elif command -v clip.exe >/dev/null; then
  printf '%s' "$BRANCH" | clip.exe
else
  echo "No clipboard tool found (pbcopy/wl-copy/xclip/clip.exe)" >&2
  echo "$BRANCH"
  exit 1
fi
echo "Copied: $BRANCH"
