#!/bin/bash
# Usage: co branch_name | co -M new_branch_name
usage() {
  echo "Usage: co branch_name | co -M new_branch_name" >&2
}

if [ "${1:-}" = "-M" ]; then
  [ "$#" -eq 2 ] && [ -n "$2" ] || { usage; exit 1; }
  git check-ref-format --branch "$2" >/dev/null 2>&1 || {
    echo "Invalid branch name: $2" >&2
    exit 1
  }
  exec git branch -M -- "$2"
fi

[ "$#" -eq 1 ] && [ -n "$1" ] || { usage; exit 1; }
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
BRANCH=$("$DIR/sb" "$1") || exit 1
exec git checkout "$BRANCH"
