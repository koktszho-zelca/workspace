#!/bin/bash
# Usage: db [-f|--force] branch_name
# Searches local branches only: exact name, then case-insensitive substring.
# Ambiguous matches are rejected, even with --force.

usage() {
  echo "Usage: db [-f|--force] branch_name" >&2
}

MODE="-d"
BRANCH=""
END_OPTIONS=false

for ARG in "$@"; do
  if [ "$END_OPTIONS" = false ]; then
    case "$ARG" in
      -f|--force) MODE="-D"; continue ;;
      --) END_OPTIONS=true; continue ;;
      -*) echo "Unknown option: $ARG" >&2; usage; exit 1 ;;
    esac
  fi
  if [ -n "$BRANCH" ] || [ -z "$ARG" ]; then
    usage
    exit 1
  fi
  BRANCH="$ARG"
done

[ -n "$BRANCH" ] || { usage; exit 1; }

git rev-parse --git-dir >/dev/null || exit 1
BRANCHES=$(git for-each-ref --format='%(refname)' refs/heads/) || exit 1
BRANCHES=$(printf '%s\n' "$BRANCHES" | sed 's|^refs/heads/||')

if printf '%s\n' "$BRANCHES" | grep -qxF -- "$BRANCH"; then
  MATCH="$BRANCH"
else
  MATCHES=()
  while IFS= read -r NAME; do
    [ -n "$NAME" ] && MATCHES+=("$NAME")
  done < <(printf '%s\n' "$BRANCHES" | grep -iF -- "$BRANCH")

  case "${#MATCHES[@]}" in
    0) echo "No local branch matching '$BRANCH'" >&2; exit 1 ;;
    1) MATCH="${MATCHES[0]}" ;;
    *)
      echo "Multiple local branches match '$BRANCH'; use an exact name:" >&2
      printf '  %s\n' "${MATCHES[@]}" >&2
      exit 1
      ;;
  esac
fi

exec git branch "$MODE" -- "$MATCH"
