#!/bin/bash
# Usage: po branch_name -> push a local branch to origin and set upstream
if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo "Usage: po branch_name" >&2
  exit 1
fi

git check-ref-format --branch "$1" >/dev/null 2>&1 || {
  echo "Invalid branch name: $1" >&2
  exit 1
}
git show-ref --verify --quiet "refs/heads/$1" || {
  echo "Local branch not found: $1" >&2
  exit 1
}
exec git push -u origin "refs/heads/$1:refs/heads/$1"
